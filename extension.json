{
	"name": "Compass",
	"author": [
		"John Lewis",
		"Universal Omega",
		"Agent Isai",
		"Zippybonzo"
	],
	"url": "https://github.com/WikiOasis/Compass",
	"descriptionmsg": "compass-desc",
	"namemsg": "compass-extensionname",
	"license-name": "GPL-3.0-or-later",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"CreateWiki": "*",
			"ManageWiki": "*"
		},
		"platform": {
			"php": ">= 8.1"
		}
	},
	"AvailableRights": [
		"compass-curate"
	],
	"SpecialPages": {
		"Compass": {
			"class": "WikiOasis\\Compass\\Specials\\SpecialCompass",
			"services": [
				"CompassStore",
				"CompassCurator",
				"CreateWikiValidator",
				"LanguageNameUtils"
			]
		},
		"RandomWiki": {
			"class": "WikiOasis\\Compass\\Specials\\SpecialRandomWiki",
			"services": [
				"CreateWikiDatabaseUtils",
				"CreateWikiValidator"
			]
		}
	},
	"APIModules": {
		"compasscurate": {
			"class": "WikiOasis\\Compass\\Api\\ApiCompassCurate",
			"services": [
				"CompassCurator"
			]
		}
	},
	"APIListModules": {
		"compass": {
			"class": "WikiOasis\\Compass\\Api\\ApiQueryCompass",
			"services": [
				"CreateWikiDatabaseUtils",
				"CreateWikiValidator",
				"LanguageNameUtils",
				"RemoteWikiFactory"
			]
		},
		"compassdirectory": {
			"class": "WikiOasis\\Compass\\Api\\ApiQueryCompassDirectory",
			"services": [
				"CompassStore",
				"CreateWikiValidator"
			]
		}
	},
	"MessagesDirs": {
		"Compass": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"CompassAliases": "CompassAliases.php",
		"CompassMagic": "CompassMagic.php"
	},
	"AutoloadNamespaces": {
		"WikiOasis\\Compass\\": "includes/"
	},
	"TestAutoloadNamespaces": {
		"WikiOasis\\Compass\\Tests\\": "tests/phpunit/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "Compass/resources"
	},
	"ResourceModules": {
		"ext.compass.styles": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxAccordion",
				"CdxButton",
				"CdxCard",
				"CdxField",
				"CdxInfoChip",
				"CdxLabel",
				"CdxMessage",
				"CdxSelect",
				"CdxTable",
				"CdxTextInput",
				"CdxThumbnail"
			],
			"styles": [
				"ext.compass.styles.less"
			]
		},
		"ext.compass.app": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxAccordion",
				"CdxButton",
				"CdxCard",
				"CdxDialog",
				"CdxField",
				"CdxIcon",
				"CdxInfoChip",
				"CdxMessage",
				"CdxProgressBar",
				"CdxSearchInput",
				"CdxSelect",
				"CdxTable",
				"CdxThumbnail"
			],
			"packageFiles": [
				{
					"name": "init.js",
					"file": "ext.compass.app/init.js"
				},
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconPushPin",
						"cdxIconTrash"
					]
				},
				{
					"name": "App.vue",
					"file": "ext.compass.app/App.vue"
				},
				{
					"name": "HighlightCard.vue",
					"file": "ext.compass.app/HighlightCard.vue"
				}
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.jqueryMsg",
				"vue"
			],
			"messages": [
				"cancel",
				"comma-separator",
				"compass-action-delete",
				"compass-action-pin",
				"compass-action-unpin",
				"compass-button-reset",
				"compass-card-more",
				"compass-delete-body",
				"compass-delete-confirm",
				"compass-delete-title",
				"compass-error-curate",
				"compass-error-load",
				"compass-filter-search",
				"compass-filter-search-placeholder",
				"compass-header",
				"compass-header-info",
				"compass-highlights-heading",
				"compass-label-active",
				"compass-label-any",
				"compass-label-closed",
				"compass-label-deleted",
				"compass-label-inactive",
				"compass-label-locked",
				"compass-label-open",
				"compass-label-private",
				"compass-label-public",
				"compass-loading",
				"compass-pagination-next",
				"compass-pagination-previous",
				"compass-results-count",
				"compass-results-empty",
				"compass-results-heading",
				"compass-sort-label",
				"compass-sort-name",
				"compass-sort-newest",
				"compass-sort-oldest",
				"compass-sort-random",
				"compass-table-actions",
				"compass-table-category",
				"compass-table-established",
				"compass-table-language",
				"compass-table-state",
				"compass-table-visibility",
				"compass-table-wiki"
			]
		}
	},
	"ResourceModuleSkinStyles": {
		"citizen": {
			"+ext.compass.app": "skinStyles/citizen/ext.compass.app.less",
			"+ext.compass.styles": "skinStyles/citizen/ext.compass.styles.less"
		}
	},
	"Hooks": {
		"CreateWikiDeletion": {
			"handler": "CreateWiki"
		},
		"CreateWikiRename": {
			"handler": "CreateWiki"
		},
		"GetMagicVariableIDs": {
			"handler": "Main"
		},
		"LoadExtensionSchemaUpdates": {
			"handler": "Installer"
		},
		"ManageWikiCoreAddFormFields": {
			"handler": "ManageWiki"
		},
		"ManageWikiCoreFormSubmission": {
			"handler": "ManageWiki"
		},
		"ParserFirstCallInit": {
			"handler": "Main"
		},
		"ParserGetVariableValueSwitch": {
			"handler": "Main"
		}
	},
	"HookHandlers": {
		"CreateWiki": {
			"class": "WikiOasis\\Compass\\HookHandlers\\CreateWiki",
			"services": [
				"CompassStore"
			]
		},
		"Installer": {
			"class": "WikiOasis\\Compass\\HookHandlers\\Installer"
		},
		"Main": {
			"class": "WikiOasis\\Compass\\HookHandlers\\Main",
			"services": [
				"CreateWikiDatabaseUtils",
				"MainConfig"
			]
		},
		"ManageWiki": {
			"class": "WikiOasis\\Compass\\HookHandlers\\ManageWiki",
			"services": [
				"CompassStore",
				"MainConfig"
			]
		}
	},
	"config": {
		"CompassDefaultVisibility": {
			"description": "Boolean. Whether wikis that have not opted in through ManageWiki are listed on Special:Compass.",
			"value": false
		},
		"CompassDescriptionsMaxLength": {
			"description": "Integer. The maximum length of the short wiki description.",
			"value": 512
		},
		"CompassExtendedDescriptionsMaxLength": {
			"description": "Integer. The maximum length of the extended wiki description.",
			"value": 4096
		},
		"CompassListPrivateWikis": {
			"description": "Boolean. Whether to show private wikis on Special:Compass.",
			"value": true
		},
		"CompassMaxHighlightedWikis": {
			"description": "Integer. The maximum number of wikis that can be highlighted on Special:Compass.",
			"value": 6
		},
		"CompassUseDescriptions": {
			"description": "Boolean. Whether to enable wiki descriptions.",
			"value": true
		},
		"CompassWikisPerPage": {
			"description": "Integer. The number of wikis listed per page on Special:Compass.",
			"value": 20
		}
	},
	"manifest_version": 2
}
